{
  "name": "bundle-breaker",
  "version": "0.1.0",
  "description": "CLI & library to reverse-engineer bundled/obfuscated JS applications.",
  "main": "dist/index.mjs",
  "bin": "dist/cli.mjs",
  "types": "dist/index.d.mts",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "files": [
    "dist/"
  ],
  "keywords": [
    "debundle",
    "unbundle",
    "webpack",
    "deobsfuscate",
    "deobsfuscator"
  ],
  "scripts": {
    "dev": "pnpm build --watch",
    "prepack": "pnpm build",
    "build": "tsdown",
    "test": "vitest",
    "examples:build-all": "node ./scripts/build-examples.ts build-all",
    "examples:build": "node ./scripts/build-examples.ts build"
  },
  "author": "awphi (adamw.ph)",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@babel/generator": "^7.24.4",
    "@babel/parser": "^7.24.4",
    "@babel/traverse": "^7.24.1",
    "@babel/types": "^7.24.0",
    "commander": "^12.0.0",
    "graphology": "^0.25.4",
    "graphology-gexf": "^0.13.0",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "24.11.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
